{
  "manifest_version": 3,
  "name": "SmartForm Filler",
  "version": "1.0.0",
  "description": "Create your profile once and intelligently detect, match, and autofill website forms with your saved information in one click.",

  "browser_specific_settings": {
    "gecko": {
      "id": "zeeshanahmed1358@gmail.com",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },

  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },

  "permissions": [
    "storage",
    "unlimitedStorage",
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "<all_urls>"
  ],

  "background": {
    "scripts": ["background.js"]
  },

  "action": {
    "default_popup": "popup.html",
    "default_title": "SmartForm Filler",
    "default_icon": {
      "16": "icons/idle16.png",
      "32": "icons/idle32.png",
      "48": "icons/idle48.png",
      "128": "icons/idle128.png"
    }
  },

  "options_page": "options.html",

  "commands": {
    "fill-form": {
      "suggested_key": {
        "default": "Alt+Shift+F"
      },
      "description": "Fill the form on this page"
    }
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "synonyms.js",
        "content.js"
      ],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ]
}
